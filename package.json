{
  "name": "five-by-five",
  "version": "1.0.0",
  "private": true,
  "description": "Personal 5x5 barbell tracker, packaged as an Android app with Capacitor",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:watch:*\" \"npm:serve\"",
    "build": "node scripts/build.js",
    "preview": "node scripts/build.js --preview",
    "watch:build": "nodemon --watch src --watch index.html --ext js,scss,html --exec \"node scripts/build.js --dev\"",
    "serve": "browser-sync start --server www --files www --no-open",
    "test": "node --test tests/*.test.js",
    "lint": "eslint src/js tests && stylelint \"src/scss/**/*.scss\"",
    "android": "npm run build && cap sync android",
    "apk": "npm run android && cd android && ./gradlew assembleRelease"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.5",
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.6",
    "cssnano": "^8.0.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.29",
    "postcss-import": "^17.0.0",
    "postcss-preset-env": "^11.6.1",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0"
  }
}
